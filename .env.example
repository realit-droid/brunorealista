# Este ficheiro é um EXEMPLO. Copia-o para um ficheiro chamado .env
# e preenche com os valores reais. O .env nunca deve ir para o Git.

# Exemplo de chave de API (substitui pelo nome real que o projeto precisar)
API_KEY=

# Exemplo de ligação a uma base de dados
DATABASE_URL=

# Ambiente (development, production)
NODE_ENV=development